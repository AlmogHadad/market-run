rules_version = '2';

// Firestore denies everything that isn't explicitly matched, so pinning the
// list ids means nothing else in the project is reachable — even though
// the project config ships in the page source.
//
// Access is "whoever has the link", deliberately: no sign-in, no accounts.
// Each list id is the secret for its household's link
// (market-run.netlify.app/#<id>). Don't publish the links anywhere public.
//
// To add a list: add its id below and publish these rules in the Firebase
// console. Keep this an explicit list — a wildcard would let anyone reading
// the page source create lists of their own in this project.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId}/{document=**} {
      allow read, write: if listId in [
        'mr-x8f3qn2vk9rt5wzp',  // original list
        'mr-1nf31fwa4r789xtx',  // extra list 1
        'mr-qvqb5hunqas0t3rb'   // extra list 2
      ];
    }
  }
}
